Options -MultiViews
RewriteEngine On

# Route-specific HTML with correct OG meta (served to bots that don't execute JS)
RewriteRule ^30th-birthday/?$ /30th-birthday-meta.html [L]
RewriteRule ^cpt-30th-birthday/?$ /cpt-30th-birthday-meta.html [L]

# SPA fallback for all other routes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # Content-hashed build assets never change for a given URL — cache aggressively
  <FilesMatch "\.(js|css|woff2?|ttf|eot|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Entry point and version manifest must always be revalidated so new builds are picked up
  <FilesMatch "^(index\.html|version\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
